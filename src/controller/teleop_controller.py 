from PySide6.QtCore import QObject, Signal, Slot
import time


class TeleopController(QObject):
    """
    主从机械臂遥操作控制器。

    职责：
    1. 接收并缓存主手关节数据。
    2. 控制遥操作的启动和停止。
    3. 将主手关节数据映射为从手目标。
    4. 通过信号将目标发送给从手线程。

    注意：
    本类不直接调用机械臂 SDK。
    """

    # 发送给从手线程的目标关节位置
    # 后续连接到 SlaveRobotThread 中接收目标位置的槽函数
    sig_set_slave_target = Signal(list)

    # 遥操作状态变化：是否运行、状态说明
    sig_teleop_state_changed = Signal(bool, str)

    # 错误或警告信息
    sig_warning = Signal(str)

    # 主手收到新数据时发出，便于主窗口显示或调试
    sig_master_data_received = Signal(list)

    def __init__(self, parent=None):
        super().__init__(parent)

        # 遥操作是否正在运行
        self.is_running = False

        # 主从设备状态，由主窗口或线程结果信号更新
        self.master_connected = False
        self.slave_connected = False
        self.slave_enabled = False

        # 缓存最新的主手关节位置
        self.master_joint_positions = None

        # 记录主手最近一次数据的到达时间
        self.last_master_data_time = None

        # 暂时不允许直接使用未经确认的关节映射
        self.mapping_configured = False

    # --------------------------------------------------
    # 主手数据接收
    # --------------------------------------------------

    @Slot(list)
    def UpdateMasterJointPositions(self, joint_positions: list):
        """
        接收 MasterRobotThread.sig_joint_positions。
        主手每读取到一组新关节数据，就调用一次。
        """

        if not joint_positions:
            return

        # 保存最新数据，避免使用旧数据
        self.master_joint_positions = list(joint_positions)
        self.last_master_data_time = time.monotonic()

        # 通知界面或调试模块
        self.sig_master_data_received.emit(
            list(self.master_joint_positions)
        )

        # 只有开始遥操作后，才向从手发送目标
        if not self.is_running:
            return

        try:
            slave_target = self.MapMasterToSlave(
                self.master_joint_positions
            )

            if not slave_target:
                self.sig_warning.emit("主手到从手的映射结果为空")
                return

            # 将目标发送给从手线程
            self.sig_set_slave_target.emit(list(slave_target))

        except (ValueError, TypeError) as exc:
            self.StopTeleop()
            self.sig_warning.emit(f"遥操作映射失败：{exc}")

    # --------------------------------------------------
    # 设备状态更新
    # --------------------------------------------------

    @Slot(bool, str)
    def OnMasterConnectResult(self, success: bool, message: str):
        """接收主手线程的连接结果。"""

        self.master_connected = success

        if not success and self.is_running:
            self.StopTeleop()

        if not success:
            self.sig_warning.emit(f"主手未连接：{message}")

    @Slot(bool, str)
    def OnSlaveConnectResult(self, success: bool, message: str):
        """接收从手线程的连接结果。"""

        self.slave_connected = success

        if not success and self.is_running:
            self.StopTeleop()

        if not success:
            self.sig_warning.emit(f"从手未连接：{message}")

    @Slot(bool, str)
    def OnSlaveEnableResult(self, success: bool, message: str):
        """接收从手使能结果。"""

        self.slave_enabled = success

        if not success and self.is_running:
            self.StopTeleop()

        if not success:
            self.sig_warning.emit(f"从手使能失败：{message}")

    @Slot(bool, str)
    def OnSlaveDisableResult(self, success: bool, message: str):
        """接收从手禁用结果。"""

        self.slave_enabled = not success

        if self.is_running:
            self.StopTeleop()

    @Slot(bool, str)
    def OnMasterDisconnectResult(self, success: bool, message: str):
        """接收主手断开结果。"""

        if success:
            self.master_connected = False
            self.StopTeleop()

    @Slot(bool, str)
    def OnSlaveDisconnectResult(self, success: bool, message: str):
        """接收从手断开结果。"""

        if success:
            self.slave_connected = False
            self.slave_enabled = False
            self.StopTeleop()

    # --------------------------------------------------
    # 遥操作启动和停止
    # --------------------------------------------------

    @Slot()
    def StartTeleop(self):
        """启动遥操作。"""

        if self.is_running:
            return

        if not self.master_connected:
            self.sig_warning.emit("无法启动遥操作：主手尚未连接")
            return

        if not self.slave_connected:
            self.sig_warning.emit("无法启动遥操作：从手尚未连接")
            return

        if not self.slave_enabled:
            self.sig_warning.emit("无法启动遥操作：从手尚未使能")
            return

        if self.master_joint_positions is None:
            self.sig_warning.emit("无法启动遥操作：尚未收到主手关节数据")
            return

        if not self.mapping_configured:
            self.sig_warning.emit(
                "无法启动遥操作：请先确认并配置主从关节映射"
            )
            return

        # 检查主手数据是否过期，避免启动时使用陈旧数据
        if self.last_master_data_time is None:
            self.sig_warning.emit("无法启动遥操作：没有有效的主手数据")
            return

        data_age = time.monotonic() - self.last_master_data_time

        if data_age > 0.5:
            self.sig_warning.emit(
                "无法启动遥操作：主手数据已超过 0.5 秒未更新"
            )
            return

        self.is_running = True
        self.sig_teleop_state_changed.emit(True, "遥操作已启动")

    @Slot()
    def StopTeleop(self):
        """停止发送新的遥操作目标。"""

        if not self.is_running:
            return

        # 先禁止后续主手数据继续转发
        self.is_running = False

        self.sig_teleop_state_changed.emit(False, "遥操作已停止")

    # --------------------------------------------------
    # 主从关节映射
    # --------------------------------------------------

    @Slot(bool)
    def SetMappingConfigured(self, configured: bool):
        """
        只有完成关节对应关系、单位、方向、零位和限位校验后，
        才允许将 configured 设置为 True。
        """

        self.mapping_configured = configured

    def MapMasterToSlave(self, master_positions: list) -> list:
        """
        将主手关节位置转换为从手目标位置。

        需要根据实际硬件实现：
        - 主从关节的对应关系
        - 角度单位转换
        - 旋转方向转换
        - 零位偏移
        - 从手关节限位检查

        当前不提供默认的直接复制映射，避免未经确认就驱动机器人。
        """

        raise NotImplementedError(
            "请根据实际主从机械臂配置实现 MapMasterToSlave()"
        )
